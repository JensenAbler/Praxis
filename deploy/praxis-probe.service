[Unit]
Description=Praxis authenticated MCP gateway
After=network.target

[Service]
Type=simple
User=praxis-probe
Group=praxis-probe
WorkingDirectory=/srv/praxis-probe/current
Environment=NODE_ENV=production
Environment=PORT=8790
Environment=PRAXIS_BASE_URL=https://mcp.jensenabler.com/praxis
Environment=PRAXIS_DATA_DIR=/var/lib/praxis-probe
EnvironmentFile=/etc/praxis-probe/release.env
LoadCredential=password-hash:/etc/praxis-probe/credentials/password-hash
LoadCredential=jwks.json:/etc/praxis-probe/credentials/jwks.json
LoadCredential=cookie-keys.json:/etc/praxis-probe/credentials/cookie-keys.json
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/praxis-probe
MemoryMax=256M
CPUQuota=25%
TasksMax=64

[Install]
WantedBy=multi-user.target
